### ============================================
### AUTH - GestionInmobiliaria
### ============================================

@baseUrl = http://localhost:5005
@token = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..w6dvjSCT5geDossRyRvyHHSIFoVnvPjquX3Eevcrr5A

### 1. Registrar usuario Admin
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "email": "admin@inmobiliaria.com",
  "password": "Admin123!",
  "nombre": "Admin",
  "apellido": "Sistema",
  "rol": "Admin"
}

###

### 2. Registrar usuario Operador
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "email": "operador@inmobiliaria.com",
  "password": "Operador123!",
  "nombre": "Juan",
  "apellido": "Pérez",
  "rol": "Operador"
}

###

### 3. Login Admin
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "admin@inmobiliaria.com",
  "password": "Admin123!"
}

###

### 4. Login Operador
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "operador@inmobiliaria.com",
  "password": "Operador123!"
}

###

### 5. Refresh token
POST {{baseUrl}}/api/auth/refresh
Content-Type: application/json

{
  "refreshToken": "TU_REFRESH_TOKEN_AQUI"
}

###

### 6. Logout
POST {{baseUrl}}/api/auth/logout
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "refreshToken": "TU_REFRESH_TOKEN_AQUI"
}

###

### 7. Actualizar perfil (usuario logueado)
PUT {{baseUrl}}/api/auth/profile
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "nombre": "Dario",
  "apellido": "Gonzalez"
}

###

### 8. Activar / desactivar usuario (solo Admin)
PATCH {{baseUrl}}/api/auth/usuarios/ID_USUARIO_AQUI/activo
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "activo": false
}

###
